{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "societa-manager-cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-24",
	// Due schedule diversi nello stesso Worker - src/index.ts guarda
	// event.cron per sapere quale dei due si e' attivato e chiama
	// l'endpoint giusto. Un cambio di cadenza qui richiede un
	// `wrangler deploy` (vedi docs/deploy-produzione.md Fase 6bis).
	"triggers": {
		// Sincronizzazione FIPAV: ciclo notturno alle 2:00 ora italiana
		// (00:xx UTC con ora legale, 01:xx UTC con ora solare - il Worker
		// procede solo se a Roma sono le 2), con riprese ai quarti d'ora se
		// il ciclo non e' finito entro i 15 minuti di un'invocazione.
		"crons": ["0,15,30,45 0,1 * * *", "0 6 * * *"]
	}
}
