# Copia questo file in .env (per Supabase locale, `supabase start` stampa questi valori).

# Connessione runtime (Supavisor transaction pooler, ?pgbouncer=true) - usata da PrismaClient.
# In produzione (pooler Supabase hosted) aggiungere &sslmode=require: il pooler
# richiede sempre TLS sulle connessioni esterne, ma pg/@prisma/adapter-pg non lo
# attiva a meno che non sia esplicito nella connection string - vedi
# docs/deploy-produzione.md Fase 5.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?pgbouncer=true"
# Connessione diretta (non pooled) - usata solo dal CLI Prisma (migrate) in prisma.config.ts.
# In produzione aggiungere anch'essa ?sslmode=require.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Da `supabase start` (locale) o dal progetto Supabase (regione EU, produzione).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Segreto condiviso col chiamante schedulato esterno (Cron) - protegge
# app/api/cron/promemoria-certificati, l'unico endpoint pubblicamente
# raggiungibile senza sessione Supabase Auth (Story 4.6, FR-16).
CRON_SECRET=""

# Story 22.1 (Epic 22, Statistiche sito pubblico): token di Cloudflare Web
# Analytics - Account Cloudflare -> Analytics & Logs -> Web Analytics ->
# Aggiungi un sito -> copiare il token dal tag JS mostrato. NON e' un
# segreto (pensato per essere incluso lato client) - se assente, nessuno
# script viene caricato (fail-soft, app/FooterPubblico.tsx).
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=""
